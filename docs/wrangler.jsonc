{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nemonik-docs",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "docs.nemonik.io", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true
}
