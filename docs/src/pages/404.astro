---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found">
  <main>
    <article id="content">
      <div class="crumb">404</div>
      <h1>Page not found</h1>
      <p class="lead">There is no page at this address.</p>
      <p>Start from the <a href="/">Introduction</a>, or press <kbd>/</kbd> to search the docs.</p>
    </article>
  </main>
</Layout>
